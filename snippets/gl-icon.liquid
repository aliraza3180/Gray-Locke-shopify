{%- doc -%}
  Inline line icons for the "GL |" sections (1.5 px stroke, 24 px grid).

  @param {string} name - Icon name (see the list in the case statement)

  @example
  {% render 'gl-icon', name: 'leaf' %}
{%- enddoc -%}
{%- if name != blank and name != 'none' -%}
  <svg class="gl-icon gl-icon--{{ name }}" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {%- case name -%}
      {%- when 'leaf' -%}
        <path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14"/><path d="M5 19c2-5 5-8 9-10"/>
      {%- when 'hair' -%}
        <path d="M12 21v-6.500"/><path d="M8.500 21c0-2.500 1.500-4 3.500-6.500 2 2.500 3.500 4 3.500 6.500"/><path d="M12 14.500C12 9 14.500 5.500 18 3"/><path d="M4 21h16"/>
      {%- when 'strands' -%}
        <path d="M6 20c0-6 3-9 6-16"/><path d="M10 20c0-5 3-8 6-15"/><path d="M14 20c0-4 2.500-6.500 5-12"/>
      {%- when 'people' -%}
        <circle cx="8.500" cy="8" r="3"/><circle cx="16" cy="8.500" r="2.600"/><path d="M3.500 19.500c.400-3.300 2.400-5.500 5-5.500s4.600 2.200 5 5.500"/><path d="M14 14.300c.600-.200 1.300-.300 2-.300 2.300 0 4 1.900 4.400 5"/>
      {%- when 'molecule' -%}
        <circle cx="12" cy="12" r="2.300"/><circle cx="5" cy="6" r="1.800"/><circle cx="19" cy="6" r="1.800"/><circle cx="12" cy="20" r="1.800"/><path d="M6.500 7.200l3.700 3.300M17.500 7.200l-3.700 3.300M12 14.300v3.900"/>
      {%- when 'dna' -%}
        <path d="M7 3c0 6 10 6 10 12s-10 3-10 6"/><path d="M17 3c0 6-10 6-10 12"/><path d="M8.500 7h7M8 17h8M9.500 12h5"/>
      {%- when 'flag' -%}
        <path d="M5 21V4"/><path d="M5 4.500h13.500v9H5"/><path d="M5 7.500h13.500M5 10.500h13.500"/><path d="M5 4.500h5.500v4.500H5z"/>
      {%- when 'gmp' -%}
        <circle cx="12" cy="10" r="6.500"/><path d="M8.500 15.500L7 21.500l5-2.500 5 2.500-1.500-6"/><path d="M9.300 10.200l1.800 1.800 3.600-3.700"/>
      {%- when 'shield' -%}
        <path d="M12 3l7 2.800v5.400c0 4.300-2.900 7.600-7 9.300-4.100-1.700-7-5-7-9.300V5.800z"/><path d="M9 12l2.200 2.200L15.200 10"/>
      {%- when 'heart' -%}
        <path d="M12 20s-7-4.300-7-9.700A3.800 3.800 0 0 1 12 8a3.800 3.800 0 0 1 7 2.300c0 5.400-7 9.700-7 9.700z"/>
      {%- when 'capsule' -%}
        <rect x="3.200" y="8.200" width="17.600" height="7.600" rx="3.800" transform="rotate(-45 12 12)"/><path d="M9.300 9.300l5.400 5.400"/>
      {%- when 'calendar' -%}
        <rect x="3.500" y="5" width="17" height="15.500" rx="2"/><path d="M3.500 9.500h17M8 3v4M16 3v4"/><path d="M8.500 14l2.200 2.200 4.300-4.300"/>
      {%- when 'clock' -%}
        <circle cx="12" cy="12" r="8.500"/><path d="M12 7.500V12l3 2"/>
      {%- when 'sparkle' -%}
        <path d="M12 3.500l1.900 5.100 5.100 1.900-5.100 1.900L12 17.500l-1.900-5.100L5 10.500l5.100-1.900z"/><path d="M18.500 16l.700 1.800 1.800.700-1.800.700-.700 1.800-.700-1.800-1.800-.700 1.800-.700z"/>
      {%- when 'sun' -%}
        <circle cx="12" cy="12" r="4"/><path d="M12 2.500v2M12 19.500v2M2.500 12h2M19.500 12h2M5.300 5.300l1.400 1.400M17.300 17.300l1.400 1.400M5.300 18.700l1.400-1.400M17.300 6.700l1.400-1.400"/>
      {%- when 'mountain' -%}
        <path d="M2.500 19.500L9 8l4 7 2.500-4 6 8.500z"/><path d="M7.300 11l1.700 1.200 1.400-1"/>
      {%- when 'drop' -%}
        <path d="M12 3.500c3.200 3.600 6 6.900 6 10.200a6 6 0 0 1-12 0c0-3.300 2.800-6.600 6-10.200z"/>
      {%- when 'truck' -%}
        <path d="M2.500 6.500h11v9.500h-11z"/><path d="M13.500 10h4.200l3.300 3.300V16h-7.500"/><circle cx="7" cy="17.500" r="1.800"/><circle cx="17" cy="17.500" r="1.800"/>
      {%- when 'lock' -%}
        <rect x="5" y="10.500" width="14" height="10" rx="2"/><path d="M8 10.500V8a4 4 0 0 1 8 0v2.500"/><path d="M12 14.500v2"/>
      {%- when 'chat' -%}
        <path d="M4 5.500h16v10.500H10l-4.500 3.500V16H4z"/><path d="M8 9.500h8M8 12.500h5"/>
      {%- when 'headset' -%}
        <path d="M4.500 14v-2a7.500 7.500 0 0 1 15 0v2"/><rect x="3.500" y="13" width="4" height="6" rx="1.500"/><rect x="16.500" y="13" width="4" height="6" rx="1.500"/><path d="M18.500 19c0 1.500-2 2.500-5 2.500"/>
      {%- when 'document' -%}
        <path d="M6 3h8.500L19 7.500V21H6z"/><path d="M14 3v5h5"/><path d="M9 12h7M9 15h7M9 18h4"/>
      {%- when 'mail' -%}
        <rect x="3" y="5.500" width="18" height="13" rx="2"/><path d="M3.500 7l8.500 6.500L20.500 7"/>
      {%- when 'check' -%}
        <path d="M5 12.500l4.500 4.500L19 7.500"/>
      {%- when 'check-circle' -%}
        <circle cx="12" cy="12" r="9"/><path d="M8 12.300l2.800 2.800L16.200 9.500"/>
      {%- when 'plus' -%}
        <path d="M12 5v14M5 12h14"/>
      {%- when 'minus' -%}
        <path d="M5 12h14"/>
      {%- when 'arrow' -%}
        <path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>
    {%- endcase -%}
  </svg>
{%- endif -%}
