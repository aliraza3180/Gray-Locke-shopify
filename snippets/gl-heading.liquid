{%- doc -%}
  Eyebrow, heading and intro text for the "GL |" sections.
  The heading has three parts so one line can be shown in gold, as in the mockups.
  Line breaks typed in the settings are kept.

  @param {string} [eyebrow] - Small uppercase line above the heading
  @param {string} [heading] - First part of the heading
  @param {string} [accent] - Part shown in gold, on its own line
  @param {string} [heading_end] - Part after the gold one, on its own line
  @param {string} [subline] - Small, widely spaced line under the heading (inside it, for screen readers)
  @param {string} [text] - Rich text below the heading
  @param {string} [tag] - Heading tag, h1 to h3. Defaults to h2
  @param {string} [size] - xl, lg, md or sm. Defaults to lg
  @param {string} [class] - Extra class on the wrapper

  @example
  {% render 'gl-heading', eyebrow: s.eyebrow, heading: s.heading, accent: s.heading_accent, text: s.text %}
{%- enddoc -%}
{%- liquid
  assign h_tag = tag | default: 'h2'
  assign h_size = size | default: 'lg'
-%}
<div class="gl-head {{ class }}">
  {%- if eyebrow != blank -%}
    <p class="gl-eyebrow">{{ eyebrow | escape }}</p>
  {%- endif -%}
  {%- if heading != blank or accent != blank or heading_end != blank -%}
    <{{ h_tag }} class="gl-heading gl-heading--{{ h_size }}">
      {%- if heading != blank -%}
        <span class="gl-heading__line">{{ heading | escape | newline_to_br }}</span>
      {%- endif -%}
      {%- if accent != blank %}
        <span class="gl-heading__line gl-heading__accent">{{ accent | escape | newline_to_br }}</span>
      {%- endif -%}
      {%- if heading_end != blank %}
        <span class="gl-heading__line">{{ heading_end | escape | newline_to_br }}</span>
      {%- endif -%}
      {%- if subline != blank %}
        <span class="gl-heading__sub">{{ subline | escape }}</span>
      {%- endif -%}
    </{{ h_tag }}>
  {%- endif -%}
  {%- if text != blank -%}
    <div class="gl-text rte">{{ text }}</div>
  {%- endif -%}
</div>
