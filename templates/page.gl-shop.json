          "type": "question",
          "settings": {
            "question": "Is Brand Name safe to take?",
            "answer": "<p>Brand Name is intended for use by healthy adults when taken according to label directions. As with any dietary supplement, consult your healthcare professional before use if you are pregnant or nursing, have a medical condition, take medications or have questions about whether Brand Name is appropriate for you.</p>"
          }
        },
        "question_00m": {
          "type": "question",
          "settings": {
            "question": "Can I take Brand Name with other supplements?",
            "answer": "<p>Brand Name contains multiple vitamins, minerals and botanical ingredients, so it’s important to consider your total daily intake from other supplements. If you take medications or other dietary supplements, talk with your healthcare professional before combining them.</p>"
          }
        },
        "question_00n": {
          "type": "question",
          "settings": {
            "question": "Does Brand Name contain any allergens?",
            "answer": "<p>Brand Name contains soy and wheat (barley grass). This product is manufactured and packaged in a facility which may also process milk, soy, wheat, egg, peanuts, tree nuts, fish and crustacean shellfish.</p>"
          }
        },
