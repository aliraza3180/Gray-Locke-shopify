{%- liquid
  assign s = section.settings
  assign eager = false
  if section.index == 1
    assign eager = true
  endif
  assign benefits = section.blocks | where: 'type', 'benefit'
  assign checks = section.blocks | where: 'type', 'check'
  assign note = s.note
  if s.product != blank and note contains '[price]'
    assign from_price = s.product.price_min | money
    assign note = note | replace: '[price]', from_price
  endif
-%}
<div
  id="GlHero-{{ section.id }}"
  class="gl gl-hero gl--{{ s.tone }} gl-hero--{{ s.height }}{% if s.image == blank %} gl-hero--no-image{% endif %}"
  style="--gl-fade: {{ s.fade | divided_by: 100.0 }}; --gl-focus: {{ s.focus }}%;"
>
  <div class="gl-hero__media">
    {%- render 'gl-image', image: s.image, image_mobile: s.image_mobile, alt: s.image_alt, sizes: '100vw', eager: eager, class: 'gl-hero__image', label: 'Hero image, 2400 x 1300 px' -%}
    {%- if s.script_text != blank -%}
      <p class="gl-script gl-hero__script">{{ s.script_text | escape | newline_to_br }}</p>
    {%- endif -%}
    {%- if s.badge_main != blank -%}
      <p class="gl-hero__badge">
        {%- if s.badge_top != blank -%}<span class="gl-hero__badge-top">{{ s.badge_top | escape }}</span>{%- endif -%}
        <span class="gl-hero__badge-main">{{ s.badge_main | escape }}</span>
        {%- if s.badge_sub != blank -%}<span class="gl-hero__badge-sub">{{ s.badge_sub | escape | newline_to_br }}</span>{%- endif -%}
      </p>
    {%- endif -%}
  </div>
  <div class="gl-container gl-hero__inner">
    <div class="gl-hero__content">
      {%- render 'gl-heading', eyebrow: s.eyebrow, heading: s.heading, accent: s.heading_accent, heading_end: s.heading_end, subline: s.subline, text: s.text, tag: s.heading_tag, size: s.heading_size -%}
      {%- if checks.size > 0 -%}
        <ul class="gl-ticks gl-hero__ticks" role="list">
          {%- for block in checks -%}
            <li {{ block.shopify_attributes }}>{%- render 'gl-icon', name: 'leaf' -%}<span>{{ block.settings.text | escape }}</span></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if benefits.size > 0 -%}
        <ul class="gl-chips gl-chips--hero" role="list" style="--gl-cols: {{ benefits.size }};">
          {%- for block in benefits -%}
            <li class="gl-chips__item" {{ block.shopify_attributes }}>
              <span class="gl-chip">{%- render 'gl-icon', name: block.settings.icon -%}</span>
              <span class="gl-chips__label">{{ block.settings.text | escape | newline_to_br }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if s.button_label != blank or s.link_label != blank -%}
        <div class="gl-actions">
          {%- render 'gl-button', label: s.button_label, url: s.button_url -%}
          {%- if s.link_label != blank and s.link_url != blank -%}
            <a class="gl-link" href="{{ s.link_url }}">{{ s.link_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if note != blank -%}
        <p class="gl-hero__note">{%- render 'gl-icon', name: s.note_icon -%}<span>{{ note | escape }}</span></p>
      {%- endif -%}
    </div>
    {%- if s.caption != blank -%}
      <p class="gl-hero__caption">{{ s.caption | escape | newline_to_br }}</p>
    {%- endif -%}
  </div>
</div>

