{%- liquid
  assign s = section.settings
  assign half = section.blocks.size | plus: 1 | divided_by: 2
-%}
<div
  id="GlDiagram-{{ section.id }}"
  class="gl gl-diagram gl--{{ s.tone }}"
  style="--gl-pt: {{ s.padding_top }}px; --gl-pb: {{ s.padding_bottom }}px;"
>
  <div class="gl-container gl-diagram__inner">
    <div class="gl-diagram__content gl-reveal">
      {%- render 'gl-heading', eyebrow: s.eyebrow, heading: s.heading, accent: s.heading_accent, heading_end: s.heading_end, subline: s.subline, text: s.text, tag: s.heading_tag, size: s.heading_size -%}
    </div>
    <div class="gl-diagram__figure">
      <ul class="gl-diagram__col gl-diagram__col--left" role="list">
        {%- for block in section.blocks limit: half -%}
          <li class="gl-callout gl-reveal" {{ block.shopify_attributes }}>
            <span class="gl-chip gl-chip--ring">{%- render 'gl-icon', name: block.settings.icon -%}</span>
            <h3 class="gl-callout__title">{{ block.settings.title | escape }}</h3>
            <p class="gl-callout__text">{{ block.settings.text | escape }}</p>
          </li>
        {%- endfor -%}
      </ul>
      <div class="gl-diagram__image">
        {%- render 'gl-image', image: s.image, alt: s.image_alt, sizes: '(min-width: 990px) 25vw, 60vw', class: 'gl-diagram__img', label: 'Diagram image, 1200 x 1200 px' -%}
      </div>
      <ul class="gl-diagram__col gl-diagram__col--right" role="list">
        {%- for block in section.blocks offset: half -%}
          <li class="gl-callout gl-reveal" {{ block.shopify_attributes }}>
            <span class="gl-chip gl-chip--ring">{%- render 'gl-icon', name: block.settings.icon -%}</span>
            <h3 class="gl-callout__title">{{ block.settings.title | escape }}</h3>
            <p class="gl-callout__text">{{ block.settings.text | escape }}</p>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</div>

{% schema %}
{
