{%- liquid
  assign s = section.settings
  assign has_head = false
  if s.heading != blank or s.eyebrow != blank or s.heading_accent != blank
    assign has_head = true
  endif
  assign title_tag = 'h3'
  unless has_head
    assign title_tag = 'h2'
  endunless
-%}
<div
  id="GlColumns-{{ section.id }}"
  class="gl gl-cols gl--{{ s.tone }} gl-cols--{{ s.style }}"
  style="--gl-pt: {{ s.padding_top }}px; --gl-pb: {{ s.padding_bottom }}px; --gl-cols: {{ section.blocks.size | at_least: 1 }};"
>
  <div class="gl-container">
    {%- if has_head -%}
      {%- render 'gl-heading', eyebrow: s.eyebrow, heading: s.heading, accent: s.heading_accent, heading_end: s.heading_end, subline: s.subline, text: s.text, tag: s.heading_tag, size: s.heading_size, class: 'gl-head--center' -%}
    {%- endif -%}
    <ol class="gl-cols__list" role="list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li class="gl-cols__item gl-reveal" {{ block.shopify_attributes }}>
          {%- if s.style == 'cards' -%}
            {%- render 'gl-image', image: b.image, alt: b.image_alt, sizes: '(min-width: 990px) 30vw, 100vw', class: 'gl-cols__image', label: 'Image, 1200 x 800 px' -%}
          {%- elsif s.style == 'steps' -%}
            <span class="gl-cols__num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          {%- else -%}
            <span class="gl-chip gl-chip--ring">{%- render 'gl-icon', name: b.icon -%}</span>
          {%- endif -%}
          <div class="gl-cols__body">
            <{{ title_tag }} class="gl-cols__title">{{ b.title | escape }}</{{ title_tag }}>
            {%- if b.text != blank -%}
              <div class="gl-cols__text rte">{{ b.text }}</div>
            {%- endif -%}
            {%- if b.button_label != blank -%}
              <div class="gl-actions">{%- render 'gl-button', label: b.button_label, url: b.button_url -%}</div>
            {%- elsif b.link_label != blank and b.link_url != blank -%}
              <a class="gl-link gl-link--arrow" href="{{ b.link_url }}">{{ b.link_label | escape }}{%- render 'gl-icon', name: 'arrow' -%}</a>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>
    {%- if s.button_label != blank -%}
      <div class="gl-actions gl-actions--center">
        {%- render 'gl-button', label: s.button_label, url: s.button_url, style: s.button_style -%}
      </div>
    {%- endif -%}
  </div>
</div>

