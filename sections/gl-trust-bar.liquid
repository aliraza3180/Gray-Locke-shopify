{%- liquid
  assign s = section.settings
-%}
{%- if section.blocks.size > 0 -%}
  <div
    id="GlTrust-{{ section.id }}"
    class="gl gl-trust gl--{{ s.tone }} gl-trust--{{ s.style }}"
    style="--gl-pt: {{ s.padding_top }}px; --gl-pb: {{ s.padding_bottom }}px; --gl-cols: {{ section.blocks.size }};"
  >
    <div class="gl-container">
      {%- if s.heading != blank -%}
        <h2 class="gl-trust__heading">{{ s.heading | escape }}</h2>
      {%- endif -%}
      <ul class="gl-trust__list" role="list" aria-label="{{ s.label | escape }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign lines = block.settings.text | newline_to_br | split: '<br />'
          -%}
          <li class="gl-trust__item" {{ block.shopify_attributes }}>
            {%- render 'gl-icon', name: block.settings.icon -%}
            {%- capture label -%}
              <span class="gl-trust__title">{{ lines.first | strip | escape }}</span>
              {%- if lines.size > 1 -%}
                <span class="gl-trust__sub">
                  {%- for line in lines offset: 1 -%}{{ line | strip | escape }}{% unless forloop.last %} {% endunless %}{%- endfor -%}
                </span>
              {%- endif -%}
            {%- endcapture -%}
            {%- if block.settings.link != blank -%}
              <a class="gl-trust__label" href="{{ block.settings.link }}">{{ label }}</a>
            {%- else -%}
              <span class="gl-trust__label">{{ label }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

