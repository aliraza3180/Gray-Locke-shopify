{%- liquid
  assign s = section.settings
  assign checks = section.blocks | where: 'type', 'check'
  assign chips = section.blocks | where: 'type', 'chip'
  assign items = section.blocks | where: 'type', 'item'
  assign cards = section.blocks | where: 'type', 'card'
  assign has_aside = false
  if items.size > 0 or cards.size > 0
    assign has_aside = true
  endif
-%}
<div
  id="GlSplit-{{ section.id }}"
  class="gl gl-split gl--{{ s.tone }} gl-split--media-{{ s.media_side }} gl-split--{{ s.media_style }}{% if cards.size > 0 %} gl-split--panel{% endif %}{% if items.size > 0 %} gl-split--items-{{ s.aside_style }}{% endif %}{% if s.image == blank %} gl-split--no-image{% endif %}"
  style="--gl-pt: {{ s.padding_top }}px; --gl-pb: {{ s.padding_bottom }}px; --gl-focus: {{ s.focus }}%;"
>
  <div class="gl-container gl-split__inner">
    {%- if s.image != blank or request.design_mode -%}
      <div class="gl-split__media gl-reveal">
        {%- render 'gl-image', image: s.image, image_mobile: s.image_mobile, alt: s.image_alt, sizes: '(min-width: 990px) 40vw, 100vw', class: 'gl-split__image', label: 'Image, 1600 x 1600 px' -%}
      </div>
    {%- endif -%}
    <div class="gl-split__content gl-reveal">
      {%- render 'gl-heading', eyebrow: s.eyebrow, heading: s.heading, accent: s.heading_accent, heading_end: s.heading_end, subline: s.subline, text: s.text, tag: s.heading_tag, size: s.heading_size -%}
      {%- if chips.size > 0 -%}
        <ul class="gl-chips gl-chips--inline" role="list" style="--gl-cols: {{ chips.size }};">
          {%- for block in chips -%}
            <li class="gl-chips__item" {{ block.shopify_attributes }}>
              <span class="gl-chip">{%- render 'gl-icon', name: block.settings.icon -%}</span>
              <span class="gl-chips__label">{{ block.settings.text | escape | newline_to_br }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if checks.size > 0 -%}
        <div class="gl-checkbox">
          {%- if s.list_heading != blank -%}
            <p class="gl-checkbox__title">{{ s.list_heading | escape }}</p>
          {%- endif -%}
          <ul class="gl-ticks" role="list">
            {%- for block in checks -%}
              <li {{ block.shopify_attributes }}>{%- render 'gl-icon', name: 'check' -%}<span>{{ block.settings.text | escape }}</span></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
      {%- if s.button_label != blank or s.link_label != blank -%}
        <div class="gl-actions">
          {%- render 'gl-button', label: s.button_label, url: s.button_url, style: s.button_style -%}
          {%- if s.link_label != blank and s.link_url != blank -%}
            <a class="gl-link" href="{{ s.link_url }}">{{ s.link_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if s.script_text != blank -%}
        <p class="gl-script">{{ s.script_text | escape | newline_to_br }}</p>
      {%- endif -%}
    </div>
    {%- if has_aside -%}
      <div class="gl-split__aside gl-reveal">
        {%- if items.size > 0 -%}
          <ul class="gl-items gl-items--{{ s.aside_style }}" role="list">
            {%- for block in items -%}
              <li class="gl-items__item" {{ block.shopify_attributes }}>
                <div class="gl-items__media">
                  {%- render 'gl-image', image: block.settings.image, alt: block.settings.image_alt, sizes: '160px', class: 'gl-items__img', label: 'Ingredient, 800 x 800 px' -%}
                </div>
                <div class="gl-items__body">
                  <h3 class="gl-items__title">{{ block.settings.title | escape }}</h3>
                  {%- if block.settings.text != blank -%}
                    <p class="gl-items__text">{{ block.settings.text | escape }}</p>
                  {%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if cards.size > 0 -%}
          <ul class="gl-panel" role="list">
            {%- for block in cards -%}
              <li class="gl-panel__item" {% if block.settings.anchor != blank %}id="{{ block.settings.anchor | handle }}"{% endif %} {{ block.shopify_attributes }}>
                {%- render 'gl-icon', name: block.settings.icon -%}
                <div>
                  <h3 class="gl-panel__title">{{ block.settings.title | escape }}</h3>
                  <div class="gl-panel__text rte">{{ block.settings.text }}</div>
                </div>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

